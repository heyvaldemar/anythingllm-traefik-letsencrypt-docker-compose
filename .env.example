# AnythingLLM + Ollama + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested without touching your
# .env. To pin a different version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# OLLAMA_IMAGE_TAG=ollama/ollama:0.40.6@sha256:…
# ANYTHINGLLM_IMAGE_TAG=mintplexlabs/anythingllm:1.18.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.anythingllm.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#
# Generate a new BCrypt hash (replace YOUR_STRONG_PASSWORD):
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# Or using docker without installing apache2-utils:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# Timeouts on Traefik's HTTPS entry point (defaults shown). The read timeout
# covers a document upload on a slow link; a model streaming its answer needs
# no write timeout. Never set the read timeout to 0s: an unbounded read lets a
# slow client hold a connection open for ever.
# TRAEFIK_READ_TIMEOUT=600s
# TRAEFIK_WRITE_TIMEOUT=0s
# TRAEFIK_IDLE_TIMEOUT=180s

# ──────────────────────────────────────────────────────────────────────────────
# AnythingLLM
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for AnythingLLM. Must resolve to this server's public IP for
# the Let's Encrypt TLS-ALPN challenge. REQUIRED.
ANYTHINGLLM_HOSTNAME=anythingllm.example.com

# The password for the instance. REQUIRED: without one, a fresh AnythingLLM
# hands an API key to anybody who asks. Generate one:
#     openssl rand -base64 24
ANYTHINGLLM_PASSWORD=change_me_generate_with_openssl_rand

# Signs the session tokens issued after a login. REQUIRED, and different from
# the password. Generate one:
#     openssl rand -hex 32
ANYTHINGLLM_JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# The Ollama model AnythingLLM chats with, and its context window in tokens.
# It must be one of the models Ollama pulls below.
# ANYTHINGLLM_CHAT_MODEL=llama3.2:3b
# ANYTHINGLLM_CHAT_MODEL_TOKEN_LIMIT=4096

# ──────────────────────────────────────────────────────────────────────────────
# Ollama (internal only: it is never published, see the README)
# ──────────────────────────────────────────────────────────────────────────────

# Models pulled on every start (comma-separated). The default, llama3.2:3b, is
# about 2 GB. Set empty to pull nothing and manage models yourself.
# OLLAMA_INSTALL_MODELS=llama3.2:3b

# NVIDIA GPU count for the (commented) GPU block in the compose file.
# OLLAMA_GPU_COUNT=all

# ──────────────────────────────────────────────────────────────────────────────
# Backups
# ──────────────────────────────────────────────────────────────────────────────

# The backups service copies AnythingLLM's SQLite database consistently
# (Python's sqlite3 backup API, no application stop) and archives the rest of
# the storage volume on a loop: the vector store, the documents, the embedder's
# model and the instance's keys. Files land in the anythingllm-backups volume.
# The archives hold the instance's API keys and signing keys: keep them as
# carefully as the .env.
# ANYTHINGLLM_BACKUP_INIT_SLEEP=30m
# ANYTHINGLLM_BACKUP_INTERVAL=24h
# ANYTHINGLLM_BACKUP_PRUNE_DAYS=7
# ANYTHINGLLM_BACKUPS_PATH=/srv/anythingllm/backups
# ANYTHINGLLM_BACKUP_NAME=anythingllm-database-backup
# ANYTHINGLLM_DATA_BACKUP_NAME=anythingllm-data-backup

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# OLLAMA_IMAGE_VERSION=0.40.9
# ANYTHINGLLM_IMAGE_VERSION=1.18.0

# ANYTHINGLLM_MEMORY_LIMIT=2g
# ANYTHINGLLM_CPU_LIMIT=2.0
# ANYTHINGLLM_MEMORY_RESERVATION=512m
# ANYTHINGLLM_CPU_RESERVATION=0.25
# ANYTHINGLLM_BACKUPS_MEMORY_LIMIT=256m
# ANYTHINGLLM_BACKUPS_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1

# The ollama service ships with no memory ceiling on purpose: its working set
# is whichever model you load. Once you know which models you run, add a
# deploy.resources.limits block to it in the compose file, with headroom above
# the largest.
